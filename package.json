{
  "name": "avito-ma-mcp",
  "version": "0.2.0",
  "description": "Unofficial Avito.ma MCP server for public search, listings, messaging, favorites and boosts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yasmine-Works/avito-mcp.git"
  },
  "homepage": "https://github.com/Yasmine-Works/avito-mcp#readme",
  "bugs": {
    "url": "https://github.com/Yasmine-Works/avito-mcp/issues"
  },
  "keywords": ["mcp", "model-context-protocol", "avito", "morocco", "classifieds", "real-estate"],
  "type": "module",
  "bin": { "avito-ma-mcp": "dist/index.js" },
  "files": [
    "dist/**/*.js",
    "README.md",
    "LICENSE",
    "docs/clients.md",
    "docs/usage.fr.md",
    ".env.example"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "npm run build && tsx --test test/*.test.ts",
    "check": "npm test",
    "smoke:public": "npm run build && node scripts/smoke-public.mjs",
    "check:package": "npm run build && node scripts/verify-package.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "engines": { "node": ">=22" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
