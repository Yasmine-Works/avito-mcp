# Valeurs à renseigner localement. Ce fichier ne contient aucun secret capturé.
AVITO_USERNAME=
AVITO_PASSWORD=
# Alternative à l'identifiant/mot de passe ; jeton gardé en mémoire uniquement.
AVITO_ACCESS_TOKEN=
# Facultatif pour avito_get_store (également accepté comme argument).
AVITO_STORE_ID=
AVITO_TIMEOUT_MS=20000
